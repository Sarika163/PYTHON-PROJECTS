import numpy as np
def F(x):
    x1, x2, x3 = x
    return np.array([
        3 * x1 - np.cos(x2 * x3) - 0.5,
        x1 ** 2 - 81 * (x2 + 0.1) ** 2 + np.sin(x3) + 1.06,
        np.exp(-x1 * x2) + 20 * x3 + 10 * np.pi - 27
    ])
def J(x):
    x1, x2, x3 = x
    return np.array([
        [3, x3 * np.sin(x2 * x3), x2 * np.sin(x2 * x3)],
        [2 * x1, -162 * (x2 + 0.1), np.cos(x3)],
        [-x2 * np.exp(-x1 * x2), -x1 * np.exp(-x1 * x2), 20]
    ])
def newton_method(F, J, x0, tol=1e-6, max_iter=10):
    x = np.array(x0, dtype=np.float64)

    for _ in range(max_iter):
        Fx = F(x)
        Jx = J(x)
        delta_x = np.linalg.solve(Jx, -Fx)
        x = x + delta_x
        if np.linalg.norm(delta_x) < tol:
            return x
        print(x)
    raise Exception("Newton's method did not converge")

